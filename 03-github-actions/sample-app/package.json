{
  "name": "sliit-sample-app",
  "version": "1.0.0",
  "description": "Sample application for GitHub Actions workshop",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "build": "echo 'Building application...' && mkdir -p dist && cp *.js dist/"
  },
  "dependencies": {
    "express": "^4.18.2"
  },
  "devDependencies": {
    "eslint": "^8.44.0",
    "jest": "^29.6.0",
    "nodemon": "^3.0.0",
    "supertest": "^6.3.0"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "*.js",
      "!jest.config.js"
    ]
  },
  "author": "SLIIT DevOps Workshop",
  "license": "MIT"
}