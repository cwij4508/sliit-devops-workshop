# Example Terraform variables file
# Copy this to terraform.tfvars and customize the values

aws_region   = "us-east-1"
project_name = "sliit-workshop"
environment  = "dev"

tags = {
  Project     = "SLIIT DevOps Workshop"
  ManagedBy   = "Terraform"
  Environment = "dev"
  Owner       = "student@sliit.lk"
}